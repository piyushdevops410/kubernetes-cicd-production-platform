apiVersion: apps/v1
kind: Deployment

metadata:
  name: kubernetes-cicd-app
  namespace: kubernetes-cicd
  labels:
    app: kubernetes-cicd-app

spec:
  replicas: 3

  selector:
    matchLabels:
      app: kubernetes-cicd-app

  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 1
      maxSurge: 1

  template:
    metadata:
      labels:
        app: kubernetes-cicd-app

    spec:
      imagePullSecrets:
        - name: ecr-registry-secret

      containers:
        - name: kubernetes-cicd-app
          image: 889038136848.dkr.ecr.us-east-1.amazonaws.com/kubernetes-cicd-production-platform:3
          imagePullPolicy: Always

          ports:
            - containerPort: 3000

          env:
            - name: PORT
              value: "3000"

            - name: APP_VERSION
              valueFrom:
                configMapKeyRef:
                  name: kubernetes-cicd-config
                  key: APP_VERSION

            - name: ENVIRONMENT
              valueFrom:
                configMapKeyRef:
                  name: kubernetes-cicd-config
                  key: ENVIRONMENT

            - name: LOG_LEVEL
              valueFrom:
                configMapKeyRef:
                  name: kubernetes-cicd-config
                  key: LOG_LEVEL

            - name: APP_SECRET
              valueFrom:
                secretKeyRef:
                  name: kubernetes-cicd-secret
                  key: APP_SECRET

          resources:
            requests:
              cpu: "100m"
              memory: "128Mi"
            limits:
              cpu: "500m"
              memory: "256Mi"

          readinessProbe:
            httpGet:
              path: /health
              port: 3000
            initialDelaySeconds: 5
            periodSeconds: 10

          livenessProbe:
            httpGet:
              path: /health
              port: 3000
            initialDelaySeconds: 10
            periodSeconds: 20
